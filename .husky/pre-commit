#!/bin/sh
# Layer 2 漏洞预判引擎 v2 — pre-commit hook
# 发现 CRITICAL/HIGH 时 exit 1 拒绝提交

SCANNER="D:/AI-Knowledge/scripts/code-scanner.py"
GAS_DIR="D:/gas-station"
START_DIR=$(pwd)
BLOCK=false

echo "=== [漏洞预判引擎 Layer2] ==="
start_time=$(date +%s)

cd "$GAS_DIR"

# L1 — 22条反模式扫描
echo "[L1] 安全反模式扫描..."
OUTPUT=$(python3 "$SCANNER" "server" 2>&1)
echo "$OUTPUT"

# 检查是否有 CRITICAL 或 HIGH
if echo "$OUTPUT" | grep -qE '\[CRITICAL\]|\[HIGH\]'; then
  echo ""
  echo "=============================================="
  echo "  拦截: 检测到 CRITICAL/HIGH 安全问题"
  echo "  修复后再提交"
  echo "=============================================="
  BLOCK=true
fi

cd "$START_DIR" 2>/dev/null
elapsed=$(($(date +%s) - start_time))
echo "=== [扫描完成: ${elapsed}s] ==="

[ "$BLOCK" = true ] && exit 1
exit 0
